# Copy to .env and fill in values before running docker compose up

# Required — generate with: openssl rand -base64 32
JWT_SECRET=

# The public URL the app is served from (no trailing slash)
PUBLIC_URL=http://localhost

# Set to true to allow username/password login as a fallback
ALLOW_LOCAL_LOGIN=false

# OAuth provider — configure these to enable SSO login
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_AUTHORIZATION_URL=
OAUTH_TOKEN_URL=
OAUTH_USERINFO_URL=
OAUTH_SCOPES=openid email profile
OAUTH_EMAIL_CLAIM=email
OAUTH_NAME_CLAIM=name
